# ===================================================
# PRIVATE TWO-USER CHAT & DISCORD BRIDGE CONFIGURATION
# ===================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_session_jwt_key_sagar_something_duo_2026_change_in_prod
DATABASE_URL="file:./dev.db"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# ===================================================
# DISCORD BRIDGE CONFIGURATION
# ===================================================
# Bot 1: Dedicated to Sagar
DISCORD_BOT_SAGAR_TOKEN=your_sagar_bot_token_here

# Bot 2: Dedicated to Something
DISCORD_BOT_SOMETHING_TOKEN=your_something_bot_token_here

# The Discord Channel ID where both bots communicate
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Discord User IDs (to identify who sent messages from Discord)
DISCORD_SAGAR_USER_ID=your_sagar_discord_user_id_here
DISCORD_SOMETHING_USER_ID=your_something_discord_user_id_here

# Optional: Discord Server (Guild) ID to restrict interactions
DISCORD_GUILD_ID=
